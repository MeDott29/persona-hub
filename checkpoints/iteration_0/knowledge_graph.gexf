      <node id="Spoegwolf" label="Spoegwolf">
        <attvalues>
          <attvalue for="0" value="concept" />
          <attvalue for="5" value="An Afrikaans band known for their powerful storytelling and emotional lyrics." />
          <attvalue for="3" value="Music" />
          <attvalue for="6" value="2025-03-06 23:54:43.573769" />
          <attvalue for="7" value="['persona_16', 'persona_17', 'persona_63']" />
          <attvalue for="8" value="[{'description': &quot;Spoegwolf's music, while not explicitly political, resonates with themes of belonging and resistance.&quot;, 'evidence': &quot;There's this one Spoegwolf song that talks about this feeling of belonging and resistance, almost like a protest.&quot;, 'novelty_score': 0.7, 'timestamp': '2025-03-06 23:54:43.573914', 'source_conversation': ['persona_16', 'persona_17', 'persona_63']}, {'description': &quot;Spoegwolf is the first Afrikaans band to top the iTunes charts worldwide, breaking barriers similar to the growing recognition of women's football.&quot;, 'evidence': &quot;Spoegwolf Fan: 'Spoegwolf is the first Afrikaans band to ever top the iTunes charts worldwide... much like how women's football is gaining more recognition globally.'&quot;, 'novelty_score': 0.9, 'timestamp': '2025-03-06 23:54:43.574300', 'source_conversation': ['persona_16', 'persona_63']}, {'description': 'Both music and sports offer powerful narratives that resonate with fans, creating a deep connection and sense of community.', 'evidence': &quot;Women's Football Fan: 'Football, too, is full of stories... It's amazing how these narratives can draw you in.'&quot;, 'novelty_score': 0.8, 'timestamp': '2025-03-06 23:54:43.574326', 'source_conversation': ['persona_16', 'persona_63']}]" />
        </attvalues>
      </node>
