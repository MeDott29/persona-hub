      <node id="Women's Football" label="Women's Football">
        <attvalues>
          <attvalue for="0" value="concept" />
          <attvalue for="5" value="A sport gaining recognition globally, with narratives of underdog victories and perseverance." />
          <attvalue for="3" value="Sports" />
