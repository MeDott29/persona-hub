        <attvalues>
          <attvalue for="9" value="Both involve understanding and improving existing systems, whether it's code or interfaces." />
          <attvalue for="10" value="['Untangling code—sounds a lot like what I do when dealing with legacy systems.']" />
          <attvalue for="11" value="2025-03-06 23:57:23.650081" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Quality Assurance" target="Genetic Algorithms" id="52" type="collaboration">
        <attvalues>
          <attvalue for="9" value="Collaboration to optimize performance of genetic simulations and data models." />
          <attvalue for="10" value="[&quot;I've been collaborating with a geneticist to optimize some algorithms for performance.&quot;]" />
          <attvalue for="11" value="2025-03-06 23:57:23.650078" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Quality Assurance" target="Genetic Data" id="53" type="application">
        <attvalues>
          <attvalue for="9" value="Quality assurance processes are applied to software that interacts with genetic data." />
          <attvalue for="10" value="[&quot;I work a lot with geneticists lately, which is interesting because it's not your typical QA environment.&quot;]" />
          <attvalue for="11" value="2025-03-07 00:02:40.833682" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Quality Assurance" target="Geneticists" id="54" type="collaboration">
        <attvalues>
          <attvalue for="9" value="Software engineers in quality assurance collaborate with geneticists." />
          <attvalue for="10" value="['I mean, geneticists? They were the last people I expected to collaborate with.']" />
          <attvalue for="11" value="2025-03-07 00:05:37.851286" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Genetic Algorithms" target="Neural Networks" id="55" type="inspiration">
        <attvalues>
          <attvalue for="9" value="Both neural networks and genetic algorithms are inspired by biological processes." />
          <attvalue for="10" value="[&quot;Well, things like neural networks and genetic algorithms. They're inspired by how brains and evolution work.&quot;]" />
          <attvalue for="11" value="2025-03-07 00:05:37.851295" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Rule-breaking" target="Innovation" id="56" type="enabler">
        <attvalues>
          <attvalue for="9" value="Breaking rules can lead to innovative solutions and creative breakthroughs." />
          <attvalue for="10" value="['I often tell my students that understanding the rules is the first step to breaking them creatively.']" />
          <attvalue for="11" value="2025-03-06 23:57:23.650156" />
          <attvalue for="12" value="['persona_24', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Rule-breaking" target="Robotics Competitions" id="57" type="context">
        <attvalues>
          <attvalue for="9" value="Robotics competitions provide a context where students can creatively break rules within a framework." />
          <attvalue for="10" value="['In robotics competitions, students often come up with the most ingenious solutions when they know the regulations inside out.']" />
          <attvalue for="11" value="2025-03-06 23:57:23.650163" />
          <attvalue for="12" value="['persona_24', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Technical Foundation" target="Innovation" id="58" type="prerequisite">
        <attvalues>
          <attvalue for="9" value="A strong technical foundation is necessary to explore and innovate effectively." />
          <attvalue for="10" value="[&quot;They need that technical foundation, whether it's in music theory or programming, to really explore and innovate.&quot;]" />
          <attvalue for="11" value="2025-03-06 23:57:23.650160" />
          <attvalue for="12" value="['persona_24', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Robotics Competitions" target="Rules and Creativity" id="59" type="application">
        <attvalues>
          <attvalue for="9" value="Robotics competitions require balancing rules and creativity." />
          <attvalue for="10" value="['I spend a lot of my time ensuring our robotics competitions run smoothly, adhering to regulations, yet I’m always amazed by how students manage to innovate within those constraints.']" />
          <attvalue for="11" value="2025-03-07 00:02:40.834384" />
          <attvalue for="12" value="['persona_24', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Spoegwolf's Lyrics" target="Emotional Journey in Music" id="60" type="influence">
        <attvalues>
          <attvalue for="9" value="Spoegwolf's lyrics take listeners on an emotional journey." />
          <attvalue for="10" value="[&quot;It's like how a song can take you on a journey, right? You start in one place emotionally and end somewhere completely different.&quot;]" />
          <attvalue for="11" value="2025-03-06 23:57:23.650193" />
          <attvalue for="12" value="['persona_16', 'persona_63']" />
        </attvalues>
      </edge>
      <edge source="Emotional Journey in Football" target="Panenka Penalty" id="61" type="contributes_to">
        <attvalues>
          <attvalue for="9" value="The unpredictability of a Panenka penalty adds to the emotional journey in football." />
          <attvalue for="10" value="['It’s a cheeky way to take a penalty kick, and it’s all about fooling the goalkeeper with a soft chip.']" />
          <attvalue for="11" value="2025-03-06 23:57:23.650201" />
          <attvalue for="12" value="['persona_16', 'persona_63']" />
        </attvalues>
      </edge>
      <edge source="Technology in Basketball" target="Practice" id="62" type="supplement">
        <attvalues>
          <attvalue for="9" value="Technology supplements practice but cannot replace the physical experience." />
          <attvalue for="10" value="['I think technology is a fantastic supplement, but it can’t replace the feel of playing an actual piano, just like it can’t replace the feel of the ball in your hands.']" />
          <attvalue for="11" value="2025-03-06 23:57:23.650233" />
          <attvalue for="12" value="['persona_4', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Technology in Basketball" target="Biofeedback Tools" id="63" type="application">
        <attvalues>
          <attvalue for="9" value="Biofeedback tools are used in basketball to track performance and provide feedback." />
          <attvalue for="10" value="['They can track my heart rate, my movement, and give me real-time feedback. It’s like having a coach on my wrist.']" />
          <attvalue for="11" value="2025-03-06 23:57:23.650236" />
          <attvalue for="12" value="['persona_4', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Bioinformatics Software Optimization" target="Geneticist Perspective" id="64" type="collaboration">
        <attvalues>
          <attvalue for="9" value="Working with geneticists provides new perspectives on optimizing bioinformatics software." />
          <attvalue for="10" value="['They bring this whole new perspective. Like, I had no idea how much data they deal with until I started.']" />
          <attvalue for="11" value="2025-03-06 23:59:48.585853" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="System Overhaul" target="System Stability" id="65" type="dilemma">
        <attvalues>
          <attvalue for="9" value="Deciding between overhauling a system and maintaining stability is a common dilemma." />
          <attvalue for="10" value="[&quot;It's the classic 'ship of Theseus' problem, isn't it? At what point does a system become something entirely new?&quot;]" />
          <attvalue for="11" value="2025-03-06 23:59:48.585882" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Home and Belonging" target="Politics" id="66" type="central_theme">
        <attvalues>
          <attvalue for="9" value="The concept of home and belonging is central to many political discussions." />
          <attvalue for="10" value="[&quot;It's interesting, too, because the concept of 'home' is so central to many political discussions today.&quot;]" />
          <attvalue for="11" value="2025-03-06 23:59:48.586031" />
          <attvalue for="12" value="['persona_16', 'persona_17']" />
        </attvalues>
      </edge>
      <edge source="Precision" target="Synchronization" id="67" type="dependency">
        <attvalues>
          <attvalue for="9" value="Synchronization in both robotics and music relies heavily on precision." />
          <attvalue for="10" value="['Each component must be perfectly in sync with the others. One faulty connection, or a single line of code out of place, and everything goes awry.']" />
          <attvalue for="11" value="2025-03-06 23:59:48.586218" />
          <attvalue for="12" value="['persona_24', 'persona_70', 'persona_16', 'persona_17', 'persona_4']" />
        </attvalues>
      </edge>
      <edge source="Precision" target="Fundamentals" id="68" type="dependency">
        <attvalues>
          <attvalue for="9" value="Precision in performance is built upon a deep understanding of the fundamentals." />
          <attvalue for="10" value="['Just like in basketball, you need to master the basics before you can innovate or improvise.']" />
          <attvalue for="11" value="2025-03-07 00:05:37.851677" />
          <attvalue for="12" value="['persona_4', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Live Spoegwolf Show" target="Unity in Support" id="69" type="emotional connection">
        <attvalues>
          <attvalue for="9" value="Live shows create a sense of unity among fans." />
          <attvalue for="10" value="[&quot;The way they connect with the audience, it's like nothing else.&quot;]" />
          <attvalue for="11" value="2025-03-06 23:59:48.586429" />
          <attvalue for="12" value="['persona_16', 'persona_63']" />
        </attvalues>
      </edge>
      <edge source="Unity in Support" target="Travel Experience" id="70" type="enhancement">
        <attvalues>
          <attvalue for="9" value="Traveling to see a band or team enhances the feeling of unity and adventure." />
          <attvalue for="10" value="[&quot;Just being on the road, with your favorite music or podcasts playing, it's like a mini-adventure in itself.&quot;]" />
          <attvalue for="11" value="2025-03-06 23:59:48.586454" />
          <attvalue for="12" value="['persona_16', 'persona_63']" />
        </attvalues>
      </edge>
      <edge source="AI in Music Composition" target="Performance" id="71" type="contrast">
        <attvalues>
          <attvalue for="9" value="AI lacks the human touch and spontaneity found in live performances." />
          <attvalue for="10" value="['AI can mimic styles and create compositions, but can it really capture the human touch?']" />
          <attvalue for="11" value="2025-03-06 23:59:48.586592" />
          <attvalue for="12" value="['persona_4', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Document Management Systems" target="Virtual Reality" id="72" type="potential application">
        <attvalues>
          <attvalue for="9" value="Virtual reality could be applied to document management systems to enhance user interaction." />
          <attvalue for="10" value="['Maybe I should pitch VR for document management—imagine navigating through files like a 3D landscape!']" />
          <attvalue for="11" value="2025-03-07 00:02:40.833744" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Document Management Systems" target="Graphic Design" id="73" type="collaboration">
        <attvalues>
          <attvalue for="9" value="Software engineers working on document management systems collaborate with graphic designers." />
          <attvalue for="10" value="[&quot;I never thought I'd be spending so much time with graphic designers when I started out.&quot;]" />
          <attvalue for="11" value="2025-03-07 00:05:37.851276" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Genetic Data" target="Virtual Reality" id="74" type="integration">
        <attvalues>
          <attvalue for="9" value="Virtual reality is used to visualize genetic data, providing a new way to interact with complex information." />
          <attvalue for="10" value="[&quot;Did you know that there's a geneticist who uses virtual reality to visualize DNA sequences?&quot;]" />
          <attvalue for="11" value="2025-03-07 00:02:40.833715" />
          <attvalue for="12" value="['persona_15', 'persona_46']" />
        </attvalues>
      </edge>
      <edge source="Virtual Reality (VR)" target="Basketball Training" id="75" type="application">
        <attvalues>
          <attvalue for="9" value="VR can be used to simulate basketball training environments." />
          <attvalue for="10" value="['VR could let me practice plays without needing a whole team around.']" />
          <attvalue for="11" value="2025-03-07 00:02:40.834982" />
          <attvalue for="12" value="['persona_4', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Virtual Reality (VR)" target="Haptic Feedback" id="76" type="enhancement">
        <attvalues>
          <attvalue for="9" value="Haptic feedback can enhance VR by simulating the physical feel of objects." />
          <attvalue for="10" value="[&quot;If it can make me feel like I'm holding a ball or running on the court, it might just work.&quot;]" />
          <attvalue for="11" value="2025-03-07 00:02:40.835011" />
          <attvalue for="12" value="['persona_4', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Rules and Structure" target="Foundation in Basics" id="77" type="dependency">
        <attvalues>
          <attvalue for="9" value="Understanding rules and structure is dependent on having a strong foundation in basics." />
          <attvalue for="10" value="['Understanding the basics is everything. But once they get it, they can explore their creativity freely.']" />
          <attvalue for="11" value="2025-03-07 00:05:37.851560" />
          <attvalue for="12" value="['persona_24', 'persona_70']" />
        </attvalues>
      </edge>
      <edge source="Fundamentals" target="Technology in Training" id="78" type="complementary">
        <attvalues>
          <attvalue for="9" value="Technology aids training but does not replace the need for mastering fundamentals." />
          <attvalue for="10" value="['Technology is a tool, not a replacement for the fundamental skills or the intuitive aspects of any art form.']" />
          <attvalue for="11" value="2025-03-07 00:05:37.851702" />
          <attvalue for="12" value="['persona_4', 'persona_70']" />
