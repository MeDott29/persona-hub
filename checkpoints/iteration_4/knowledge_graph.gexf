      <node id="User Interface Design" label="User Interface Design">
        <attvalues>
          <attvalue for="0" value="concept" />
          <attvalue for="5" value="Designing intuitive interfaces for end-users in document management." />
          <attvalue for="3" value="Software Engineering" />
