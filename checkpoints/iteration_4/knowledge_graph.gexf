      <edge source="Robotics" target="Music Theory" id="29" type="similarity">
        <attvalues>
          <attvalue for="9" value="Both fields involve rules and structures, with room for creativity." />
          <attvalue for="10" value="[&quot;I guess both of us are in the business of rules and structures, whether it's in competitions or compositions.&quot;, 'Sometimes I think of programming a robot like composing a piece of music.']" />
